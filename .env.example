# Default: SQLite database stored at data/warehouse.db
DATABASE_URL=sqlite:///data/warehouse.db

# Optional MySQL example:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/ecommerce_dw

# Optional AWS S3 upload (leave blank to skip)
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=ecommerce-pipeline
